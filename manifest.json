{
  "manifest_version": 3,
  "name": "WA Focus",
  "description": "Hide the chat list on WhatsApp Web so one conversation fills the window.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "css": ["focus.css"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "WA Focus",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
